#!/usr/bin/env python3
"""changeName – ersetzt einen Namen rekursiv in Ordnernamen, Dateinamen,
Dateiinhalten und Symlink-Zielen, in allen gängigen Schreibweisen.

Aufruf:
    ./changeName .                  # fragt ALT und NEU interaktiv ab
    ./changeName . ALT NEU          # Namen direkt übergeben
    ./changeName . ALT NEU -n       # Probelauf: nur anzeigen, nichts ändern
    ./changeName . ALT NEU -c       # nur exakt die eingegebene Schreibweise

Beispiel: `./changeName . lstm abcd` ersetzt lstm -> abcd, LSTM -> ABCD und
Lstm -> Abcd.

Das Verfahren (Phasen, Korrektheitsargumente, Grenzen) ist in
docs/changeName.md dokumentiert; die Abschnittsnummern in den Kommentaren
beziehen sich auf dieses Dokument.
"""

from __future__ import annotations

import argparse
import os
import re
import secrets
import shutil
import stat
import sys
import tempfile
from dataclasses import dataclass, field

# Namen, die nie betreten oder verändert werden (Abschnitt 6): Metadaten von
# Versionsverwaltungen (eine Änderung beschädigt das Repository), regenerierbare
# Caches und fremde Abhängigkeiten. Gilt für Ordner und Dateien gleichermaßen,
# denn in Submodulen und Worktrees ist `.git` eine Datei.
DEFAULT_EXCLUDES = frozenset({
    ".git", ".hg", ".svn", ".bzr",
    "__pycache__", ".mypy_cache", ".pytest_cache", ".ruff_cache", ".tox",
    ".venv", "venv", "node_modules",
})

TEMP_PREFIX = ".changeName-"


# --------------------------------------------------------------------------
# Ersetzungsfunktion σ (Abschnitt 3)
# --------------------------------------------------------------------------

def as_typed(s: str) -> str:
    return s


def upper_first(s: str) -> str:
    return s[:1].upper() + s[1:]


def lower_first(s: str) -> str:
    return s[:1].lower() + s[1:]


def capitalized(s: str) -> str:
    return s[:1].upper() + s[1:].lower()


# Unterstützte Schreibweisen in absteigendem Vorrang (Abschnitt 3.2). Jede
# Funktion leitet aus der eingegebenen Form eine Schreibweise ab; dieselbe
# Funktion, angewandt auf NEU, liefert den Ersatz im selben Stil.
CASE_STYLES = (as_typed, str.lower, str.upper, upper_first, lower_first, capitalized)


class Replacer:
    """σ: ersetzt alle Schreibweisen von ALT in einem Durchlauf (Abschnitt 3).

    `pairs` bildet jede erkannte Schreibweise von ALT auf NEU im selben Stil
    ab. Fallen zwei Schreibweisen zusammen (bei `lstm` sind „wie eingegeben“
    und „klein“ dieselbe Form), gilt die vorrangige.
    """

    def __init__(self, old: str, new: str, ignore_case: bool = True):
        self.pairs: dict[str, str] = {}
        for style in CASE_STYLES if ignore_case else CASE_STYLES[:1]:
            self.pairs.setdefault(style(old), style(new))
        self.ascii = all(a.isascii() and n.isascii() for a, n in self.pairs.items())

        # Längste Form zuerst: Pythons Alternation nimmt die erste passende
        # Alternative, so gewinnt bei gleichem Startpunkt der längste Treffer.
        forms = sorted(self.pairs, key=len, reverse=True)
        self._text_re = re.compile("|".join(map(re.escape, forms)))
        self._bytes_pairs = {a.encode("utf-8"): n.encode("utf-8") for a, n in self.pairs.items()}
        self._bytes_re = re.compile(b"|".join(re.escape(a.encode("utf-8")) for a in forms))

        # Nur zum Melden von Vorkommen in nicht unterstützter Schreibweise
        # (z. B. `lStM`); ersetzt wird ausschließlich über `pairs`.
        self._loose_text = re.compile(re.escape(old), re.IGNORECASE) if ignore_case else None
        self._loose_bytes = (re.compile(re.escape(old.encode("ascii")), re.IGNORECASE)
                             if ignore_case and old.isascii() else None)

    def changes(self) -> dict[str, str]:
        """Die Paare, die tatsächlich etwas ändern."""
        return {a: n for a, n in self.pairs.items() if a != n}

    def sub(self, text: str) -> str:
        return self._text_re.sub(lambda m: self.pairs[m.group()], text)

    def sub_bytes(self, data: bytes) -> bytes:
        return self._bytes_re.sub(lambda m: self._bytes_pairs[m.group()], data)

    def count(self, text: str) -> int:
        """Anzahl der Treffer, die sich durch die Ersetzung ändern."""
        return sum(1 for m in self._text_re.finditer(text) if self.pairs[m.group()] != m.group())

    def count_bytes(self, data: bytes) -> int:
        return sum(1 for m in self._bytes_re.finditer(data)
                   if self._bytes_pairs[m.group()] != m.group())

    def unsupported(self, text: str) -> list[str]:
        """Vorkommen von ALT in einer Schreibweise, die σ nicht ersetzt."""
        if self._loose_text is None:
            return []
        return [m.group() for m in self._loose_text.finditer(text) if m.group() not in self.pairs]

    def unsupported_bytes(self, data: bytes) -> list[str]:
        if self._loose_text is None:
            return []
        if self._loose_bytes is not None:
            found = (m.group().decode("ascii") for m in self._loose_bytes.finditer(data))
            return [s for s in found if s not in self.pairs]
        try:
            return self.unsupported(data.decode("utf-8"))
        except UnicodeDecodeError:
            return []


def describe_unsupported(found: list[str]) -> str:
    examples = ", ".join(f"'{s}'" for s in sorted(set(found))[:3])
    return f"{len(found)} Vorkommen in nicht unterstützter Schreibweise ({examples}) nicht ersetzt"


@dataclass
class Plan:
    """Alle Änderungen, vollständig vor der ersten Schreiboperation berechnet.

    Sämtliche Pfade beziehen sich auf den Ausgangszustand des Baums.
    """
    contents: list[tuple[str, int]] = field(default_factory=list)     # (Pfad, Vorkommen)
    links: list[tuple[str, str, str]] = field(default_factory=list)   # (Pfad, altes, neues Ziel)
    renames: list[tuple[str, str]] = field(default_factory=list)      # (Quelle, Ziel), tiefste zuerst
    warnings: list[tuple[str, str]] = field(default_factory=list)     # bewusst übersprungen
    errors: list[tuple[str, str]] = field(default_factory=list)       # nicht durchführbar

    def is_empty(self) -> bool:
        return not (self.contents or self.links or self.renames)


# --------------------------------------------------------------------------
# Phase 1: Erfassung (Abschnitt 4.1)
# --------------------------------------------------------------------------

def iter_entries(root: str, excludes: frozenset[str], errors: list) -> list[str]:
    """Alle Einträge unterhalb von `root` (ohne `root` selbst).

    Ausgeschlossene Namen werden vor dem Abstieg entfernt (Pruning), damit ihr
    Inhalt nie gelesen wird. Symlinks auf Ordner erscheinen als Eintrag, werden
    aber nicht betreten (followlinks=False), sonst könnte das Werkzeug Dateien
    außerhalb von `root` verändern oder in Zyklen laufen.
    """
    def on_error(err: OSError) -> None:
        errors.append((err.filename or root, f"nicht lesbar: {err.strerror}"))

    entries = []
    for dirpath, dirnames, filenames in os.walk(root, onerror=on_error):
        dirnames[:] = sorted(d for d in dirnames if d not in excludes)
        for name in dirnames + sorted(f for f in filenames if f not in excludes):
            entries.append(os.path.join(dirpath, name))
    return entries


# --------------------------------------------------------------------------
# Phase 2: Planung (Abschnitte 4.2–4.5)
# --------------------------------------------------------------------------

def is_utf8(data: bytes) -> bool:
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        return False
    return True


def plan_content(path: str, replacer: Replacer, plan: Plan) -> None:
    """Prüft, ob und wie der Inhalt einer regulären Datei ersetzt werden darf.

    Ersetzt wird auf Byte-Ebene (Abschnitt 4.3). Das ist bei reinen
    ASCII-Formen in jeder ASCII-kompatiblen Kodierung korrekt; enthält eine
    Form Nicht-ASCII-Zeichen, nur wenn die Datei gültiges UTF-8 ist
    (Selbstsynchronisation von UTF-8).
    """
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError as e:
        plan.errors.append((path, f"nicht lesbar: {e.strerror}"))
        return

    count = replacer.count_bytes(data)
    unsupported = replacer.unsupported_bytes(data)
    if not count and not unsupported:
        return
    if b"\0" in data:
        plan.warnings.append(
            (path, f"Binärdatei, {count + len(unsupported)} Vorkommen nicht ersetzt"))
        return
    if not replacer.ascii and not is_utf8(data):
        plan.warnings.append((path, f"kein gültiges UTF-8, {count} Vorkommen nicht ersetzt"))
        return
    if count:
        plan.contents.append((path, count))
    if unsupported:
        plan.warnings.append((path, describe_unsupported(unsupported)))


def in_renamed_area(directory: str, root_abs: str, excludes: frozenset[str]) -> bool:
    """True, wenn Einträge direkt in `directory` von der Umbenennung erfasst werden."""
    try:
        if os.path.commonpath([root_abs, directory]) != root_abs:
            return False
    except ValueError:  # z. B. unterschiedliche Laufwerke unter Windows
        return False
    rel = os.path.relpath(directory, root_abs)
    return not any(part in excludes for part in rel.split(os.sep))


def map_link_target(link: str, target: str, root_abs: str, replacer: Replacer,
                    excludes: frozenset[str]) -> str:
    """Überträgt die Umbenennungen komponentenweise auf ein Symlink-Ziel (Abschnitt 4.5).

    Das Ziel wird lexikalisch vom Ordner des Links aus durchlaufen. Eine
    Komponente wird genau dann ersetzt, wenn sie einen Eintrag bezeichnet, den
    Phase 6 umbenennt – also innerhalb von `root`, aber nicht `root` selbst und
    nicht in einem ausgeschlossenen Bereich. So bleibt der Link nach der
    Umbenennung gültig, während Pfade außerhalb von `root` unverändert bleiben.
    """
    cur = os.sep if os.path.isabs(target) else os.path.dirname(os.path.abspath(link))
    parts = []
    for comp in target.split(os.sep):
        if comp in ("", "."):
            parts.append(comp)
        elif comp == "..":
            parts.append(comp)
            cur = os.path.dirname(cur)
        else:
            renamed = comp not in excludes and in_renamed_area(cur, root_abs, excludes)
            parts.append(replacer.sub(comp) if renamed else comp)
            cur = os.path.join(cur, comp)
    return os.sep.join(parts)


def same_entry(a: str, b: str) -> bool:
    """True, wenn beide Pfade denselben Verzeichniseintrag bezeichnen.

    Nötig für Dateisysteme ohne Unterscheidung von Groß-/Kleinschreibung, auf
    denen `foo` -> `Foo` sonst fälschlich als Konflikt gälte.
    """
    try:
        sa, sb = os.lstat(a), os.lstat(b)
    except OSError:
        return False
    return (sa.st_dev, sa.st_ino) == (sb.st_dev, sb.st_ino)


def self_identity() -> tuple[int, int] | None:
    """(Gerät, Inode) dieses Skripts, damit es sich nicht selbst verändert."""
    try:
        st = os.stat(os.path.abspath(__file__))
    except OSError:
        return None
    return (st.st_dev, st.st_ino)


def build_plan(root: str, replacer: Replacer, excludes: frozenset[str]) -> Plan:
    plan = Plan()
    root_abs = os.path.abspath(root)
    me = self_identity()
    targets: set[str] = set()

    for path in iter_entries(root, excludes, plan.errors):
        try:
            st = os.lstat(path)
        except OSError as e:
            plan.errors.append((path, f"nicht lesbar: {e.strerror}"))
            continue
        if (st.st_dev, st.st_ino) == me:
            continue

        # Nur reguläre Dateien: Lesen eines FIFOs würde blockieren, Geräte-
        # dateien haben keinen "Inhalt"; Symlinks werden über ihr Ziel behandelt.
        if stat.S_ISREG(st.st_mode):
            plan_content(path, replacer, plan)
        elif stat.S_ISLNK(st.st_mode):
            target = os.readlink(path)
            if replacer.count(target):
                new_target = map_link_target(path, target, root_abs, replacer, excludes)
                if new_target != target:
                    plan.links.append((path, target, new_target))
                else:
                    plan.warnings.append(
                        (path, "Symlink-Ziel: Vorkommen liegen außerhalb des Baums, nicht ersetzt"))

        name = os.path.basename(path)
        unsupported = replacer.unsupported(name)
        if unsupported:
            plan.warnings.append((path, "Name: " + describe_unsupported(unsupported)))
        new_name = replacer.sub(name)
        if new_name == name:
            continue
        dst = os.path.join(os.path.dirname(path), new_name)
        if new_name in (".", ".."):
            plan.errors.append((path, f"ungültiger neuer Name '{new_name}'"))
        elif dst in targets or (os.path.lexists(dst) and not same_entry(path, dst)):
            # Nie überschreiben (Abschnitt 4.4).
            plan.errors.append((path, f"'{new_name}' existiert bereits, nicht umbenannt"))
        else:
            targets.add(dst)
            plan.renames.append((path, dst))

    # Tiefste Einträge zuerst (Abschnitt 4.4): Beim Umbenennen eines Eintrags
    # tragen alle seine Vorfahren noch ihre alten Namen, der Pfad ist gültig.
    plan.renames.sort(key=lambda r: r[0].count(os.sep), reverse=True)
    return plan


# --------------------------------------------------------------------------
# Phasen 4–6: Ausführung
# --------------------------------------------------------------------------

def rewrite_file(path: str, replacer: Replacer) -> None:
    """Ersetzt den Inhalt atomar: temporäre Datei schreiben, fsync, umbenennen.

    Bei einem Abbruch liegt immer entweder die alte oder die neue Fassung vor,
    nie eine halb geschriebene (Abschnitt 4.6). Die Zugriffsrechte bleiben
    erhalten, die Änderungszeit wird bewusst neu gesetzt.
    """
    with open(path, "rb") as f:
        data = f.read()
    new_data = replacer.sub_bytes(data)
    if new_data == data:
        return

    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=TEMP_PREFIX)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(new_data)
            f.flush()
            os.fsync(f.fileno())
        shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def retarget_symlink(path: str, new_target: str) -> None:
    """Setzt das Ziel eines Symlinks atomar neu (neuer Link + os.replace)."""
    tmp = os.path.join(os.path.dirname(path), TEMP_PREFIX + secrets.token_hex(8))
    os.symlink(new_target, tmp)
    try:
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def apply_plan(plan: Plan, replacer: Replacer, root: str) -> int:
    """Führt den Plan aus und liefert die Anzahl fehlgeschlagener Operationen.

    Reihenfolge: Inhalte, Symlink-Ziele, dann Umbenennungen. Die ersten beiden
    Phasen arbeiten so noch auf den unveränderten Pfaden des Plans.
    """
    failures = 0

    def fail(path: str, reason: str) -> None:
        nonlocal failures
        failures += 1
        print(f"FEHLER {os.path.relpath(path, root)}: {reason}", file=sys.stderr)

    for path, _ in plan.contents:
        try:
            rewrite_file(path, replacer)
        except OSError as e:
            fail(path, e.strerror or str(e))

    for path, _, new_target in plan.links:
        try:
            retarget_symlink(path, new_target)
        except OSError as e:
            fail(path, e.strerror or str(e))

    for src, dst in plan.renames:
        # Erneute Prüfung: der Baum kann sich seit der Planung geändert haben.
        if os.path.lexists(dst) and not same_entry(src, dst):
            fail(src, f"'{os.path.basename(dst)}' existiert inzwischen, nicht umbenannt")
            continue
        try:
            os.rename(src, dst)
        except OSError as e:
            fail(src, e.strerror or str(e))

    return failures


# --------------------------------------------------------------------------
# Bedienoberfläche
# --------------------------------------------------------------------------

def validate_names(old: str, new: str) -> str | None:
    """Fehlermeldung bei unzulässigen Namen, sonst None."""
    if not old or not new:
        return "ALT und NEU dürfen nicht leer sein."
    for name in (old, new):
        if os.sep in name or (os.altsep and os.altsep in name) or "\0" in name:
            return f"'{name}' darf weder '{os.sep}' noch ein NUL-Zeichen enthalten."
        try:
            name.encode("utf-8")
        except UnicodeEncodeError:
            return f"'{name}' ist kein gültiger Unicode-Text."
    if old == new:
        return "ALT und NEU sind identisch, es gibt nichts zu tun."
    return None


def ask(prompt: str) -> str:
    try:
        return input(prompt).strip()
    except EOFError:
        return ""


def confirm(prompt: str) -> bool:
    return ask(prompt).lower() in ("j", "ja", "y", "yes")


def show_plan(plan: Plan, root: str) -> None:
    def rel(p: str) -> str:
        return os.path.relpath(p, root)

    if plan.contents:
        total = sum(n for _, n in plan.contents)
        print(f"\nDateiinhalte ({len(plan.contents)} Dateien, {total} Vorkommen):")
        for path, n in plan.contents:
            print(f"  {rel(path)}  ({n}x)")
    if plan.links:
        print(f"\nSymlink-Ziele ({len(plan.links)}):")
        for path, old_t, new_t in plan.links:
            print(f"  {rel(path)}:  {old_t}  ->  {new_t}")
    if plan.renames:
        print(f"\nUmbenennungen ({len(plan.renames)}):")
        for src, dst in sorted(plan.renames):
            print(f"  {rel(src)}  ->  {os.path.basename(dst)}")
    if plan.warnings:
        print(f"\nÜbersprungen ({len(plan.warnings)}):")
        for path, reason in plan.warnings:
            print(f"  {rel(path)}: {reason}")
    if plan.errors:
        print(f"\nNicht durchführbar ({len(plan.errors)}):")
        for path, reason in plan.errors:
            print(f"  {rel(path)}: {reason}")


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="changeName",
        description="Ersetzt ALT durch NEU in Ordnernamen, Dateinamen, Dateiinhalten "
                    "und Symlink-Zielen unterhalb von VERZEICHNIS, in allen "
                    "Schreibweisen im selben Stil (lstm/Lstm/LSTM -> abcd/Abcd/ABCD). "
                    "Ausgenommen: " + ", ".join(sorted(DEFAULT_EXCLUDES)) + ".",
        epilog="Fehlen ALT/NEU, werden sie interaktiv abgefragt. "
               "Dokumentation: docs/changeName.md")
    parser.add_argument("verzeichnis", metavar="VERZEICHNIS",
                        help="Startordner, z. B. '.' für den aktuellen Ordner "
                             "(wird selbst nicht umbenannt)")
    parser.add_argument("alt", metavar="ALT", nargs="?", help="zu ersetzender Name")
    parser.add_argument("neu", metavar="NEU", nargs="?", help="neuer Name")
    parser.add_argument("-c", "--case-sensitive", action="store_true",
                        help="nur exakt die eingegebene Schreibweise ersetzen")
    parser.add_argument("-n", "--dry-run", action="store_true",
                        help="nur anzeigen, was geändert würde")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="ohne Rückfrage ausführen")
    parser.add_argument("-e", "--exclude", metavar="NAME", action="append", default=[],
                        help="weiteren Ordner-/Dateinamen ausnehmen (mehrfach möglich)")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    # Dateinamen müssen nicht gültiges UTF-8 sein; die Ausgabe darf daran nicht scheitern.
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(errors="backslashreplace")

    root = args.verzeichnis
    if not os.path.isdir(root):
        print(f"changeName: '{root}' ist kein Ordner.", file=sys.stderr)
        return 2

    old = args.alt if args.alt is not None else ask("Alter Name (wird gesucht): ")
    new = args.neu if args.neu is not None else ask("Neuer Name (ersetzt ihn):   ")
    problem = validate_names(old, new)
    if problem:
        print(f"changeName: {problem}", file=sys.stderr)
        return 2

    replacer = Replacer(old, new, ignore_case=not args.case_sensitive)
    excludes = DEFAULT_EXCLUDES | frozenset(args.exclude)
    print(f"Verzeichnis : {os.path.abspath(root)}")
    print("Ersetzung   : " + ", ".join(f"'{a}' -> '{n}'" for a, n in replacer.changes().items())
          + ("  (nur exakte Schreibweise)" if args.case_sensitive else ""))
    print(f"Ausgenommen : {', '.join(sorted(excludes))}")

    plan = build_plan(root, replacer, excludes)
    show_plan(plan, root)
    planning_failed = 1 if plan.errors else 0

    if plan.is_empty():
        print("\nKeine Vorkommen gefunden, nichts zu tun.")
        return planning_failed
    if args.dry_run:
        print("\nProbelauf: es wurde nichts verändert.")
        return planning_failed
    if not args.yes and not confirm("\nÄnderungen durchführen? [j/N] "):
        print("Abgebrochen, es wurde nichts verändert.")
        return 1

    failures = apply_plan(plan, replacer, root)
    done = len(plan.contents) + len(plan.links) + len(plan.renames) - failures
    print(f"\nFertig: {done} Änderungen durchgeführt, {failures} fehlgeschlagen.")
    return 1 if failures or plan.errors else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nAbgebrochen.", file=sys.stderr)
        sys.exit(130)
